# Jindo Assistant — copy to .env and fill in. Never commit .env.
# This repo is intended to be PUBLIC; keep secrets out of git.

# Optional PIN gate (leave unset to skip)
ASSISTANT_PIN=

# User context
ASSISTANT_USER_NAME=Junaid Khan
ASSISTANT_TIMEZONE=Asia/Karachi

# monday.com (https://developer.monday.com/)
MONDAY_API_TOKEN=
MONDAY_DEFAULT_BOARD_ID=
MONDAY_API_URL=https://api.monday.com/v2
# Optional column ID overrides if your board uses custom IDs
MONDAY_PERSON_COLUMN_ID=person
MONDAY_STATUS_COLUMN_ID=status
MONDAY_DATE_COLUMN_ID=date

# httpSMS self-hosted or cloud (https://docs.httpsms.com/)
HTTPSMS_BASE_URL=https://api.httpsms.com
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=

# Google Calendar — choose ONE auth method (documented in README)
GOOGLE_CALENDAR_ID=
# Option A: service account JSON file path (share the calendar with the SA email)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: OAuth refresh token flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional LLM for intent parsing (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
